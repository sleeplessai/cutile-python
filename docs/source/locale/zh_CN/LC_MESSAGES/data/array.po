msgid "cuda.tile.Array"
msgstr "cuda.tile.Array"

#: cuda.tile._stub.Array:1 of
msgid "Class for |global array| objects."
msgstr "表示 |global array| 对象的类。"

#: cuda.tile.Array.dtype:1 of
