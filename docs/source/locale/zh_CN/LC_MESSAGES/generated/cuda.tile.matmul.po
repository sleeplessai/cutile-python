#: ../../source/generated/cuda.tile.matmul.rst:2
msgid "cuda.tile.matmul"
msgstr "cuda.tile.matmul"

#: cuda.tile._stub.matmul:1 of
msgid "Performs matrix multiply on the given tiles."
msgstr "对给定的 Tile 执行矩阵乘法。"

#: ../../source/generated/cuda.tile.matmul.rst
msgid "Parameters"
msgstr "参数"

#: cuda.tile._stub.matmul:3 of
msgid "LHS of the matmul, 1D, 2D, or 3D."
msgstr "矩阵乘法的左操作数（LHS），支持一维、二维或三维。"

#: cuda.tile._stub.matmul:5 of
msgid "RHS of the matmul, 1D, 2D, or 3D."
msgstr "矩阵乘法的右操作数（RHS），支持一维、二维或三维。"

#: cuda.tile._stub.matmul:8 of
msgid ""
"Supported input datatypes: [f16, bf16, f32, f64, tf32, f8e4m3fn, f8e5m2, "
"i8, u8]"
msgstr "支持的输入数据类型：[f16, bf16, f32, f64, tf32, f8e4m3fn, f8e5m2, i8, u8]"

#: cuda.tile._stub.matmul:10 of
msgid ""
"If `x` and `y` have different dtype, they will first be promoted to "
"common dtype. The result dtype is the same as the promoted input types. "
"Shape of `x` and `y` will be broadcasted to up until the last two axes."
msgstr ""
"如果 ``x`` 和 ``y`` 具有不同的数据类型，它们会先被提升到公共数据类型。结果的数据类型与提升后的输入类型相同。 ``x`` 和 "
"``y`` 除最后两个轴之外的前导维度将进行广播。"

#: ../../source/generated/cuda.tile.matmul.rst
msgid "Return type"
msgstr "返回类型"

