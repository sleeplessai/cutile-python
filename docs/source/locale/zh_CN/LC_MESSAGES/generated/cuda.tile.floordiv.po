#: ../../source/generated/cuda.tile.floordiv.rst:2
msgid "cuda.tile.floordiv"
msgstr "cuda.tile.floordiv"

#: cuda.tile._stub.floordiv:1 of
msgid "Elementwise floordiv on two tiles."
msgstr "对两个 Tile 执行逐元素向下取整除法（floordiv）。"

#: cuda.tile._stub.floordiv:3 of
msgid "Can also use builtin operation ``x // y``."
msgstr "也可使用内置运算 ``x // y`` 。"

#: cuda.tile._stub.floordiv:5 of
msgid ""
"Supports both integer and floating-point operands. For float inputs, the "
"result is ``floor(x / y)`` as a float (e.g. ``5.5 // 2.2 == 2.0``)."
msgstr "同时支持整数和浮点操作数。对于浮点输入，结果为浮点型的 ``floor(x / y)`` （例如 ``5.5 // 2.2 == 2.0`` ）。"

