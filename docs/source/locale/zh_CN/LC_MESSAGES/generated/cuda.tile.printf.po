#: ../../source/generated/cuda.tile.printf.rst:2
msgid "cuda.tile.printf"
msgstr "cuda.tile.printf"

#: cuda.tile._stub.printf:1 of
msgid "Print the values at runtime from the device"
msgstr "在运行时从设备端打印数值。"

#: cuda.tile._stub.printf of
msgid "Parameters"
msgstr "参数"

#: cuda.tile._stub.printf:3 of
msgid ""
"a c-printf style format string in the form of "
"``%[flags][width][.precision][length]specifier``, where specifier is "
"limited to integer and float for now, i.e. ``[diuoxXeEfFgGaA]``"
msgstr ""
"C 语言 printf 风格的格式字符串，形式为 ``%[flags][width][.precision][length]specifier``"
" ，其中格式说明符目前仅限整数和浮点数，即 ``[diuoxXeEfFgGaA]`` 。"

#: cuda.tile._stub.printf:8 of
msgid "Only tile input is supported."
msgstr "仅支持 Tile 输入。"

#: cuda.tile._stub.printf:12 of
msgid "Examples"
msgstr "示例"

#: cuda.tile._stub.printf:22 of
msgid "Output"
msgstr "输出"

#: cuda.tile._stub.printf:24 of
msgid "Notes"
msgstr "备注"

#: cuda.tile._stub.printf:25 of
msgid ""
"This operation has significant overhead, and should only be used for "
"debugging purpose."
msgstr "该操作开销较大，仅应用于调试目的。"

