#: ../../source/generated/cuda.tile.mma.rst:2
msgid "cuda.tile.mma"
msgstr "cuda.tile.mma"

#: cuda.tile._stub.mma:1 of
msgid "Matrix multiply-accumulate."
msgstr "矩阵乘加（MMA）。"

#: cuda.tile._stub.mma:3 of
msgid ""
"Computes ``(x @ y) + acc`` as a single operation (where ``@`` denotes "
"matrix multiplication). Preserves the dtype of `acc`."
msgstr "作为单个操作计算 ``(x @ y) + acc`` （其中 ``@`` 表示矩阵乘法）。保留 ``acc`` 的数据类型。"

#: ../../source/generated/cuda.tile.mma.rst
msgid "Parameters"
msgstr "参数"

#: cuda.tile._stub.mma:7 of
msgid "LHS of the mma, 2D or 3D."
msgstr "MMA 的左操作数（LHS），支持二维或三维。"

#: cuda.tile._stub.mma:9 of
msgid "RHS of the mma, 2D or 3D."
msgstr "MMA 的右操作数（RHS），支持二维或三维。"

#: cuda.tile._stub.mma:11 of
msgid "Accumulator of mma."
msgstr "MMA 的累加器。"

#: cuda.tile._stub.mma:13 of
msgid ""
"Enable fast accumulation mode, which trades accumulator precision for "
"throughput. Requires fp8 input dtypes (``float8_e4m3fn`` or "
"``float8_e5m2``). Currently only has an effect on Hopper GPUs; silently "
"ignored on other architectures. Default: ``False`` (since CTK 13.3)."
msgstr ""
"启用快速累加模式，以牺牲一定累加器精度来换取更高的吞吐量。需要 FP8 输入数据类型（ ``float8_e4m3fn`` 或 "
"``float8_e5m2`` ）。目前仅在 Hopper GPU 上生效；在其他架构上将被静默忽略。默认值： ``False`` （自 CTK "
"13.3 起）。"

#: cuda.tile._stub.mma:20 of
msgid "Supported datatypes:"
msgstr "支持的数据类型："

