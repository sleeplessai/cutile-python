msgid "cuda.tile.unpack\\_from\\_bytes"
msgstr "cuda.tile.unpack\\_from\\_bytes"

#: cuda.tile._stub.unpack_from_bytes:1 of
msgid "Reinterprets a 1D uint8 byte tile as a 1D tile of the target data type."
msgstr "将一维 uint8 字节 Tile 重新解释为目标数据类型的一维 Tile。"

#: cuda.tile._stub.unpack_from_bytes:3 of
msgid ""
"The inverse of :py:func:`pack_to_bytes`. The input must be a 1D tile of "
"dtype uint8, and the total number of bits must be divisible by the target"
" data type bit width."
msgstr ""
":py:func:`pack_to_bytes` 的逆操作。输入必须是数据类型为 uint8 的一维 "
"Tile，且总比特位数必须能被目标数据类型的位宽整除。"

#: ../../source/generated/cuda.tile.unpack_from_bytes.rst
msgid "Parameters"
msgstr "参数"

#: cuda.tile._stub.unpack_from_bytes:7 of
msgid "a 1D tile of dtype uint8."
msgstr "数据类型为 uint8 的一维 Tile。"

#: cuda.tile._stub.unpack_from_bytes:9 of
msgid "target data type."
msgstr "目标数据类型。"

#: ../../source/generated/cuda.tile.unpack_from_bytes.rst
