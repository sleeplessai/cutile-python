msgid "Parameters"
msgstr "参数"

#: cuda.tile._stub.mma_scaled:13 of
msgid "LHS input, 2D or 3D ``[..., M, K]``."
msgstr "左操作数（LHS）输入，二维或三维，形状为 ``[..., M, K]`` 。"

#: cuda.tile._stub.mma_scaled:15 of
msgid ""
"Scale factors for x, shape ``[..., M, K_s]``. All dimensions except K_s "
"must match x exactly."
msgstr "``x`` 的缩放因子，形状为 ``[..., M, K_s]`` 。除 ``K_s`` 之外的所有维度都必须与 ``x`` 完全匹配。"

#: cuda.tile._stub.mma_scaled:18 of
msgid "RHS input, 2D or 3D ``[..., K, N]``."
msgstr "右操作数（RHS）输入，二维或三维，形状为 ``[..., K, N]`` 。"

#: cuda.tile._stub.mma_scaled:20 of
msgid ""
"Scale factors for y, shape ``[..., K_s, N]``. All dimensions except K_s "
"must match y exactly."
msgstr "``y`` 的缩放因子，形状为 ``[..., K_s, N]`` 。除 ``K_s`` 之外的所有维度都必须与 ``y`` 完全匹配。"

#: cuda.tile._stub.mma_scaled:23 of
