msgstr "沿所有轴进行归约。"

#: cuda.tile._stub.max:31 of
msgid "Reduce axis 1 and keepdims."
msgstr "沿轴 1 进行归约并保留维度（keepdims）。"

#: cuda.tile._stub.max:45 of
msgid "Reduce axes (1, 2)."
msgstr "沿轴 (1, 2) 进行归约。"

