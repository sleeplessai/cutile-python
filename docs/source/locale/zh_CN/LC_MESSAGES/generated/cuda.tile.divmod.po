#: ../../source/generated/cuda.tile.divmod.rst:2
msgid "cuda.tile.divmod"
msgstr "cuda.tile.divmod"

#: cuda.tile._stub.divmod:1 of
msgid "Elementwise ``divmod()`` on two tiles."
msgstr "对两个 Tile 执行逐元素 ``divmod()`` 运算。"

#: cuda.tile._stub.divmod:3 of
msgid ""
"For integer inputs, returns ``(x // y, x % y)``. For floating-point "
"inputs, not yet implemented."
msgstr "对于整数输入，返回 ``(x // y, x % y)`` 。暂不支持浮点输入。"

#: cuda.tile._stub.divmod:6 of
msgid "Can also use the builtin operation `divmod(x, y)`."
msgstr "也可使用内置运算 ``divmod(x, y)`` 。"

#: ../../source/generated/cuda.tile.divmod.rst
msgid "Parameters"
msgstr "参数"

#: cuda.tile._stub.divmod:8 of
msgid "dividend tile."
msgstr "被除数 Tile。"

#: cuda.tile._stub.divmod:10 of
msgid "divisor tile."
msgstr "除数 Tile。"

#: cuda.tile._stub.divmod:13 of
msgid ""
"The `shape` of `x` and `y` will be broadcasted and `dtype` promoted to "
"common dtype."
msgstr "``x`` 和 ``y`` 的 ``shape`` 将会进行广播，且 ``dtype`` 会提升为公共数据类型（common dtype）。"

#: ../../source/generated/cuda.tile.divmod.rst
msgid "Returns"
msgstr "返回值"

#: cuda.tile._stub.divmod:16 of
msgid "Tuple of two tiles (quotient and remainder)."
msgstr "由两个 Tile（商和余数）组成的元组。"

